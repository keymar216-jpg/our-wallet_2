rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
    }

    match /rooms/{roomId} {
      // Room codes are intended to be shared privately between exactly two people.
      // Authenticated users may get a room document when they know its code; listing rooms is disabled.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.monthlyBudget == 0
        && request.resource.data.schemaVersion == 1;
      allow update: if signedIn() && (
        // Join one additional user only; room size is capped at two.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && resource.data.memberUids.size() == 1
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && !(request.auth.uid in resource.data.memberUids)
        )
        ||
        // Existing members may change the shared monthly budget.
        (
          request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monthlyBudget'])
          && request.resource.data.monthlyBudget is number
          && request.resource.data.monthlyBudget >= 0
          && request.resource.data.monthlyBudget <= 100000000
        )
      );
      allow delete: if false;

      match /expenses/{expenseId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.keys().hasAll(['category','detail','amount','date','memo','createdAt','createdBy','updatedAt','updatedBy'])
          && request.resource.data.category is string
          && request.resource.data.detail is string
          && request.resource.data.detail.size() > 0
          && request.resource.data.detail.size() <= 80
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 10000000
          && request.resource.data.date is string
          && request.resource.data.memo is string
          && request.resource.data.memo.size() <= 200
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;
        allow update: if isMember(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category','detail','amount','date','memo','updatedAt','updatedBy'])
          && request.resource.data.category is string
          && request.resource.data.detail is string
          && request.resource.data.detail.size() > 0
          && request.resource.data.detail.size() <= 80
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 10000000
          && request.resource.data.date is string
          && request.resource.data.memo is string
          && request.resource.data.memo.size() <= 200
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isMember(roomId);
      }
    }
  }
}